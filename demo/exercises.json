{
 "muscles": {
  "chest": {
   "name": "Chest",
   "anat": "Pectoralis major",
   "does": "Pushes your arms forward and across your body. The upper fibers make the shelf under the collarbone that shows in a tank top."
  },
  "delts_front": {
   "name": "Front shoulder",
   "anat": "Anterior deltoid",
   "does": "Lifts your arm forward. Works in every press, so it rarely needs much extra."
  },
  "delts_side": {
   "name": "Side shoulder",
   "anat": "Lateral deltoid",
   "does": "Lifts your arm out to the side. This is the muscle that makes shoulders look wide and capped."
  },
  "delts_rear": {
   "name": "Rear shoulder",
   "anat": "Posterior deltoid",
   "does": "Pulls your arm back. Rounds the shoulder from behind and keeps you from slouching."
  },
  "biceps": {
   "name": "Biceps",
   "anat": "Biceps brachii, brachialis",
   "does": "Bends the elbow and turns the palm up. The brachialis underneath pushes the biceps up for a taller peak."
  },
  "triceps": {
   "name": "Triceps",
   "anat": "Triceps brachii",
   "does": "Straightens the elbow. About two thirds of upper-arm size."
  },
  "forearms": {
   "name": "Forearms and grip",
   "anat": "Wrist flexors and extensors, brachioradialis",
   "does": "Close your hand and hold the bar. Climbing strength lives here."
  },
  "abs": {
   "name": "Abs",
   "anat": "Rectus abdominis",
   "does": "Curls your ribs toward your hips. The six-pack muscle. It shows when body fat is low and it is thick."
  },
  "obliques": {
   "name": "Obliques",
   "anat": "External and internal obliques",
   "does": "Twist and side-bend your trunk. They frame the abs and tighten the waist."
  },
  "hip_flexors": {
   "name": "Hip flexors",
   "anat": "Iliopsoas, rectus femoris",
   "does": "Lift your knee toward your chest. Work hard in leg raises and sprinting."
  },
  "traps": {
   "name": "Traps",
   "anat": "Trapezius",
   "does": "Shrug and hold your shoulders back. The upper part shows beside the neck in a tank top."
  },
  "upper_back": {
   "name": "Upper back",
   "anat": "Rhomboids, middle trapezius",
   "does": "Pull your shoulder blades together. Posture and a thick back."
  },
  "lats": {
   "name": "Lats",
   "anat": "Latissimus dorsi",
   "does": "Pull your arms down and back. Width of the back. The pull-up muscle."
  },
  "lower_back": {
   "name": "Lower back",
   "anat": "Erector spinae",
   "does": "Keep your spine straight under load."
  },
  "glutes": {
   "name": "Glutes",
   "anat": "Gluteus maximus and medius",
   "does": "Drive your hips forward. The main engine for jumping and sprinting."
  },
  "quads": {
   "name": "Quads",
   "anat": "Quadriceps",
   "does": "Straighten the knee. They push the floor away when you jump."
  },
  "hamstrings": {
   "name": "Hamstrings",
   "anat": "Biceps femoris, semitendinosus, semimembranosus",
   "does": "Bend the knee and extend the hip. Protect the knee when you land."
  },
  "adductors": {
   "name": "Inner thigh",
   "anat": "Adductors",
   "does": "Pull the legs together and help in deep squats."
  },
  "calves": {
   "name": "Calves",
   "anat": "Gastrocnemius, soleus",
   "does": "Point the foot. The last push off the ground in a jump."
  }
 },
